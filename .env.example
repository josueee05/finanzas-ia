# Copia este archivo como .env.local y completa lo que necesites.

# IA (opcional). Sin esta variable la app usa el modo demo: clasificación por
# palabras clave, gratis y sin conexión. Consíguela en https://console.anthropic.com
ANTHROPIC_API_KEY=

# Modelo de Claude para categorizar (opcional)
# AI_MODEL=claude-opus-5-5

# Zona horaria para calcular "hoy" y el mes actual (opcional)
# APP_TIME_ZONE=America/Guatemala

# Directorio de la base de datos local PGlite (opcional)
# PGLITE_DATA_DIR=./.data/pglite
