# Copia este archivo como .env.local y completa lo que necesites.
# En desarrollo NINGUNA variable es obligatoria: la app funciona tal cual.

# --- Sesiones -----------------------------------------------------------------
# Clave para firmar la cookie de sesión. OBLIGATORIA en producción (mín. 32 caracteres).
# Genera una con:  openssl rand -base64 32
AUTH_SECRET=

# --- Login con GitHub (opcional) ----------------------------------------------
# Crea una OAuth App en https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/github/callback (o tu dominio en producción)
# Sin estas variables solo se muestra "Probar como invitado".
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Base de datos ------------------------------------------------------------
# Producción: URL de PostgreSQL (p. ej. Neon, usa la cadena "pooled").
# Sin ella se usa PGlite (Postgres en WebAssembly) guardado en .data/
# DATABASE_URL=postgresql://usuario:clave@host/base?sslmode=require
# DB_POOL_MAX=5
# PGLITE_DATA_DIR=./.data/pglite

# --- IA (opcional) ------------------------------------------------------------
# Sin esta variable la app usa el modo demo (palabras clave y preguntas frecuentes),
# gratis y sin conexión. Consíguela en https://console.anthropic.com
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5

# --- Otros --------------------------------------------------------------------
# Zona horaria para calcular "hoy" y el mes actual
# APP_TIME_ZONE=America/Guatemala
